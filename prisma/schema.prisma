// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ExpenseType {
  SUPERMARKET
  RECEIPT
  INVOICE
  OTHER
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(cuid())
  name      String?
  email     String     @unique
  password  String
  role      Role       @default(USER)
  status    UserStatus @default(ACTIVE)
  expenses  Expense[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("users")
}

model CostCenter {
  id          String    @id @default(cuid())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("cost_centers")
}

model Expense {
  id           String      @id @default(cuid())
  amount       Decimal     @db.Decimal(10, 2)
  date         DateTime
  merchant     String      @db.VarChar(255)
  expenseType  ExpenseType @default(OTHER)
  notes        String?     @db.Text

  // Relations
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  // File & AI
  imageUrl  String? @db.Text // URL del comprobante en Vercel Blob
  rawAiData Json?   // Datos crudos retornados por Gemini (para auditoría)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([costCenterId])
  @@index([userId])
  @@index([date])
  @@map("expenses")
}
